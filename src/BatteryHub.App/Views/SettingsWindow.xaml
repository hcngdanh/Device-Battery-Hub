<Window x:Class="BatteryHub.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BatteryHub.App.Localization"
        xmlns:c="clr-namespace:BatteryHub.App.Controls"
        Title="Battery Hub"
        Width="880" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12.5"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Navigation ================= -->
        <DockPanel Margin="12,14,8,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,2,0,18">
                <Image Source="{StaticResource AppLogo}" Width="30" Height="30" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:Loc AppName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="NavVersion" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE713;" Content="{l:Loc NavGeneral}" Checked="OnNavChecked" IsChecked="True"/>
                <RadioButton x:Name="NavTaskbar" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE7F4;" Content="{l:Loc NavTaskbar}" Checked="OnNavChecked"/>
                <RadioButton x:Name="NavNotifications" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xEA8F;" Content="{l:Loc NavNotifications}" Checked="OnNavChecked"/>
                <RadioButton x:Name="NavGameMode" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE7FC;" Content="{l:Loc NavGameMode}" Checked="OnNavChecked"/>
                <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE81C;" Content="{l:Loc NavHistory}" Checked="OnNavChecked"/>
                <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE946;" Content="{l:Loc NavAbout}" Checked="OnNavChecked"/>
            </StackPanel>
        </DockPanel>

        <!-- ================= Pages ================= -->
        <ScrollViewer x:Name="PageScroller" Grid.Column="1" Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
            <Grid Margin="16,22,20,28" MaxWidth="820" HorizontalAlignment="Stretch">

                <!-- ===== General ===== -->
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Text="{l:Loc NavGeneral}" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <c:SettingRow Icon="&#xE774;" Header="{l:Loc Language}" Description="{l:Loc LanguageDesc}">
                                <ComboBox x:Name="LanguageCombo" Style="{StaticResource FluentComboBox}" MinWidth="170" SelectionChanged="OnLanguageChanged">
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Tiếng Việt"/>
                                </ComboBox>
                            </c:SettingRow>
                            <Border Style="{StaticResource RowDivider}"/>
                            <c:SettingRow Icon="&#xE790;" Header="{l:Loc Theme}" Description="{l:Loc ThemeDesc}">
                                <ComboBox x:Name="ThemeCombo" Style="{StaticResource FluentComboBox}" MinWidth="170" SelectionChanged="OnThemeChanged">
                                    <ComboBoxItem Content="{l:Loc ThemeSystem}"/>
                                    <ComboBoxItem Content="{l:Loc ThemeLight}"/>
                                    <ComboBoxItem Content="{l:Loc ThemeDark}"/>
                                </ComboBox>
                            </c:SettingRow>
                            <Border Style="{StaticResource RowDivider}"/>
                            <c:SettingRow Icon="&#xE7E8;" Header="{l:Loc Startup}" Description="{l:Loc StartupDesc}">
                                <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}" Click="OnStartupClick"/>
                            </c:SettingRow>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,0">
                        <StackPanel>
                            <c:SettingRow x:Name="SettingsFileRow" Icon="&#xEDE1;" Header="{l:Loc SettingsFile}" Description="{l:Loc SettingsFileDesc}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource StandardButton}" Content="{l:Loc Import}" Click="OnImportClick"/>
                                    <Button Style="{StaticResource StandardButton}" Content="{l:Loc Export}" Margin="8,0,0,0" Click="OnExportClick"/>
                                </StackPanel>
                            </c:SettingRow>
                            <Border Style="{StaticResource RowDivider}"/>
                            <c:SettingRow Icon="&#xE777;" Header="{l:Loc Reset}" Description="{l:Loc ResetDesc}">
                                <Button Style="{StaticResource StandardButton}" Content="{l:Loc ResetButton}" Click="OnResetClick"/>
                            </c:SettingRow>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="GeneralStatus" Margin="4,10,0,0" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>

                <!-- ===== Taskbar ===== -->
                <StackPanel x:Name="PageTaskbar" Visibility="Collapsed">
                    <TextBlock Text="{l:Loc NavTaskbar}" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <c:SettingRow Icon="&#xE7F4;" Header="{l:Loc ShowOnTaskbar}" Description="{l:Loc ShowOnTaskbarDesc}">
                                <CheckBox x:Name="OverlayToggle" Style="{StaticResource ToggleSwitch}" Click="OnSimpleToggle"/>
                            </c:SettingRow>
                            <Border Style="{StaticResource RowDivider}"/>
                            <c:SettingRow x:Name="PositionRow" Icon="&#xE8A0;" Header="{l:Loc TaskbarPosition}" Description="{l:Loc TaskbarPositionDesc}">
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="PositionLeft" GroupName="TbPos" Style="{StaticResource SegmentItem}" Content="{l:Loc PositionLeft}" Checked="OnSegmentChecked"/>
                                        <RadioButton x:Name="PositionTray" GroupName="TbPos" Style="{StaticResource SegmentItem}" Content="{l:Loc PositionTray}" Checked="OnSegmentChecked"/>
                                    </StackPanel>
                                </Border>
                            </c:SettingRow>
                            <Border Style="{StaticResource RowDivider}"/>
                            <StackPanel Margin="16,12,16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE890;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="22" Margin="0,0,16,0"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{l:Loc TaskbarDisplay}" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{l:Loc TaskbarDisplayDesc}" FontSize="11.5" Margin="0,2,0,0" Foreground="{DynamicResource SubTextBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <UniformGrid Columns="3" Margin="35,12,-3,0" MaxWidth="480" HorizontalAlignment="Left">
                                    <RadioButton x:Name="LayoutPercentRadio" GroupName="TaskbarLayout" Style="{StaticResource PreviewTile}"
                                                 Tag="{l:Loc LayoutPercent}" Checked="OnLayoutChecked">
                                        <ContentControl x:Name="PreviewPercent" ContentTemplate="{StaticResource TaskbarItemContent}" Focusable="False"/>
                                    </RadioButton>
                                    <RadioButton x:Name="LayoutBatteryRadio" GroupName="TaskbarLayout" Style="{StaticResource PreviewTile}"
                                                 Tag="{l:Loc LayoutBattery}" Checked="OnLayoutChecked">
                                        <ContentControl x:Name="PreviewBattery" ContentTemplate="{StaticResource TaskbarItemContent}" Focusable="False"/>
                                    </RadioButton>
                                    <RadioButton x:Name="LayoutBothRadio" GroupName="TaskbarLayout" Style="{StaticResource PreviewTile}"
                                                 Tag="{l:Loc LayoutBoth}" Checked="OnLayoutChecked">
                                        <ContentControl x:Name="PreviewBoth" ContentTemplate="{StaticResource TaskbarItemContent}" Focusable="False"/>
                                    </RadioButton>
                                </UniformGrid>
                            </StackPanel>
                            <Border Style="{StaticResource RowDivider}"/>
                            <c:SettingRow x:Name="ColorCodeRow" Icon="&#xE790;" Header="{l:Loc ColorCode}">
                                <CheckBox x:Name="ColorCodeToggle" Style="{StaticResource ToggleSwitch}" Click="OnSimpleToggle"/>
                            </c:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Notifications ===== -->
                <StackPanel x:Name="PageNotifications" Visibility="Collapsed">
                    <TextBlock Text="{l:Loc NavNotifications}" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <c:SettingRow Icon="&#xE708;" Header="{l:Loc RespectFocus}" Description="{l:Loc RespectFocusDesc}">
                                <CheckBox x:Name="FocusToggle" Style="{StaticResource ToggleSwitch}" Click="OnSimpleToggle"/>
                            </c:SettingRow>
                            <Border Style="{StaticResource RowDivider}"/>
                            <c:SettingRow Icon="&#xE767;" Header="{l:Loc Sound}" Description="{l:Loc SoundDesc}">
                                <CheckBox x:Name="SoundToggle" Style="{StaticResource ToggleSwitch}" Click="OnSimpleToggle"/>
                            </c:SettingRow>
                            <c:SettingRow x:Name="SoundChoiceRow" Style="{StaticResource SubRow}" Header="{l:Loc SoundChoice}">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="SoundCombo" Style="{StaticResource FluentComboBox}" MinWidth="190" SelectionChanged="OnSoundChanged">
                                        <ComboBoxItem Content="{l:Loc SoundDefault}"/>
                                        <ComboBoxItem Content="{l:Loc SoundNotify}"/>
                                        <ComboBoxItem Content="{l:Loc SoundChimes}"/>
                                        <ComboBoxItem Content="{l:Loc SoundDing}"/>
                                        <ComboBoxItem Content="{l:Loc SoundAlarm}"/>
                                    </ComboBox>
                                    <Button Style="{StaticResource StandardButton}" MinWidth="0" Margin="8,0,0,0" Click="OnPreviewSoundClick" ToolTip="{l:Loc Preview}">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </c:SettingRow>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,0">
                        <StackPanel>
                            <c:SettingRow Icon="&#xE851;" Header="{l:Loc LowBattery}" Description="{l:Loc LowBatteryDesc}">
                                <CheckBox x:Name="LowToggle" Style="{StaticResource ToggleSwitch}" Click="OnSimpleToggle"/>
                            </c:SettingRow>
                            <c:SettingRow x:Name="LowThresholdRow" Style="{StaticResource SubRow}" Header="{l:Loc Threshold}">
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="LowSlider" Style="{StaticResource FluentSlider}" Width="200" Minimum="5" Maximum="50"
                                            TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="OnSliderChanged"/>
                                    <TextBlock x:Name="LowValue" Width="44" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </c:SettingRow>

                            <Border Style="{StaticResource RowDivider}"/>
                            <c:SettingRow Icon="&#xE850;" Header="{l:Loc CriticalBattery}" Description="{l:Loc CriticalBatteryDesc}">
                                <CheckBox x:Name="CriticalToggle" Style="{StaticResource ToggleSwitch}" Click="OnSimpleToggle"/>
                            </c:SettingRow>
                            <c:SettingRow x:Name="CriticalThresholdRow" Style="{StaticResource SubRow}" Header="{l:Loc Threshold}">
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="CriticalSlider" Style="{StaticResource FluentSlider}" Width="200" Minimum="3" Maximum="30"
                                            TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="OnSliderChanged"/>
                                    <TextBlock x:Name="CriticalValue" Width="44" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </c:SettingRow>
                            <c:SettingRow x:Name="CriticalRepeatRow" Style="{StaticResource SubRow}" Header="{l:Loc RepeatEvery}">
                                <ComboBox x:Name="RepeatCombo" Style="{StaticResource FluentComboBox}" SelectionChanged="OnComboChanged"/>
                            </c:SettingRow>

                            <Border Style="{StaticResource RowDivider}"/>
                            <c:SettingRow Icon="&#xE83F;" Header="{l:Loc FullCharge}" Description="{l:Loc FullChargeDesc}">
                                <CheckBox x:Name="FullToggle" Style="{StaticResource ToggleSwitch}" Click="OnSimpleToggle"/>
                            </c:SettingRow>
                            <c:SettingRow x:Name="FullTargetRow" Style="{StaticResource SubRow}" Header="{l:Loc FullTarget}">
                                <ComboBox x:Name="FullTargetCombo" Style="{StaticResource FluentComboBox}" SelectionChanged="OnComboChanged">
                                    <ComboBoxItem Content="100%"/>
                                    <ComboBoxItem Content="95%"/>
                                    <ComboBoxItem Content="90%"/>
                                    <ComboBoxItem Content="85%"/>
                                    <ComboBoxItem Content="80%"/>
                                </ComboBox>
                            </c:SettingRow>

                            <Border Style="{StaticResource RowDivider}"/>
                            <c:SettingRow Icon="&#xE83E;" Header="{l:Loc ChargerState}">
                                <CheckBox x:Name="ChargerToggle" Style="{StaticResource ToggleSwitch}" Click="OnSimpleToggle"/>
                            </c:SettingRow>
                            <Border Style="{StaticResource RowDivider}"/>
                            <c:SettingRow Icon="&#xE702;" Header="{l:Loc Connection}">
                                <CheckBox x:Name="ConnectionToggle" Style="{StaticResource ToggleSwitch}" Click="OnSimpleToggle"/>
                            </c:SettingRow>

                            <Border Style="{StaticResource RowDivider}"/>
                            <c:SettingRow Icon="&#xE823;" Header="{l:Loc Reminder}" Description="{l:Loc ReminderDesc}">
                                <CheckBox x:Name="ReminderToggle" Style="{StaticResource ToggleSwitch}" Click="OnSimpleToggle"/>
                            </c:SettingRow>
                            <c:SettingRow x:Name="ReminderTimeRow" Style="{StaticResource SubRow}" Header="{l:Loc ReminderTime}">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="ReminderHourCombo" Style="{StaticResource FluentComboBox}" MinWidth="72" MaxDropDownHeight="260" SelectionChanged="OnComboChanged"/>
                                    <TextBlock Text=":" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                    <ComboBox x:Name="ReminderMinuteCombo" Style="{StaticResource FluentComboBox}" MinWidth="72" SelectionChanged="OnComboChanged"/>
                                </StackPanel>
                            </c:SettingRow>
                            <c:SettingRow x:Name="ReminderThresholdRow" Style="{StaticResource SubRow}" Header="{l:Loc ReminderBelow}">
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="ReminderSlider" Style="{StaticResource FluentSlider}" Width="200" Minimum="10" Maximum="90"
                                            TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="OnSliderChanged"/>
                                    <TextBlock x:Name="ReminderValue" Width="44" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </c:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Game mode ===== -->
                <StackPanel x:Name="PageGameMode" Visibility="Collapsed">
                    <TextBlock Text="{l:Loc NavGameMode}" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <c:SettingRow Icon="&#xE7FC;" Header="{l:Loc GameAuto}" Description="{l:Loc GameAutoDesc}">
                                <CheckBox x:Name="GameAutoToggle" Style="{StaticResource ToggleSwitch}" Click="OnSimpleToggle"/>
                            </c:SettingRow>
                            <Border Style="{StaticResource RowDivider}"/>
                            <c:SettingRow Icon="&#xEA8F;" Header="{l:Loc GameNotif}" Description="{l:Loc GameNotifDesc}">
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="GameNotifCompact" GroupName="GameNotif" Style="{StaticResource SegmentItem}" Content="{l:Loc GameNotifCompact}" Checked="OnSegmentChecked"/>
                                        <RadioButton x:Name="GameNotifOff" GroupName="GameNotif" Style="{StaticResource SegmentItem}" Content="{l:Loc GameNotifOff}" Checked="OnSegmentChecked"/>
                                    </StackPanel>
                                </Border>
                            </c:SettingRow>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{l:Loc OverlayGroup}" Style="{StaticResource GroupHeader}"/>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <c:SettingRow Icon="&#xE7F4;" Header="{l:Loc Overlay}" Description="{l:Loc OverlayDesc}">
                                <CheckBox x:Name="GameOverlayToggle" Style="{StaticResource ToggleSwitch}" Click="OnSimpleToggle"/>
                            </c:SettingRow>
                            <c:SettingRow x:Name="HotkeyRow" Style="{StaticResource SubRow}" Header="{l:Loc Hotkey}" Description="{l:Loc HotkeyDesc}">
                                <Button x:Name="HotkeyButton" Style="{StaticResource StandardButton}" MinWidth="150"
                                        Click="OnHotkeyClick" PreviewKeyDown="OnHotkeyKeyDown" LostFocus="OnHotkeyLostFocus" Focusable="True"/>
                            </c:SettingRow>
                            <c:SettingRow x:Name="CornerRow" Style="{StaticResource SubRow}" Header="{l:Loc Corner}">
                                <Border Style="{StaticResource SegmentHost}">
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="CornerTL" GroupName="Corner" Style="{StaticResource SegmentItem}" Content="&#x2196;" FontSize="14" Checked="OnSegmentChecked"/>
                                        <RadioButton x:Name="CornerTR" GroupName="Corner" Style="{StaticResource SegmentItem}" Content="&#x2197;" FontSize="14" Checked="OnSegmentChecked"/>
                                        <RadioButton x:Name="CornerBL" GroupName="Corner" Style="{StaticResource SegmentItem}" Content="&#x2199;" FontSize="14" Checked="OnSegmentChecked"/>
                                        <RadioButton x:Name="CornerBR" GroupName="Corner" Style="{StaticResource SegmentItem}" Content="&#x2198;" FontSize="14" Checked="OnSegmentChecked"/>
                                    </UniformGrid>
                                </Border>
                            </c:SettingRow>
                            <c:SettingRow x:Name="OpacityRow" Style="{StaticResource SubRow}" Header="{l:Loc Opacity}">
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="OpacitySlider" Style="{StaticResource FluentSlider}" Width="200" Minimum="30" Maximum="100"
                                            TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="OnSliderChanged"/>
                                    <TextBlock x:Name="OpacityValue" Width="44" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </c:SettingRow>
                            <c:SettingRow x:Name="OverlayDevicesRow" Style="{StaticResource SubRow}" Header="{l:Loc OverlayDevices}" Description="{l:Loc OverlayDevicesDesc}">
                                <StackPanel x:Name="OverlayDevicesPanel" MinWidth="200"/>
                            </c:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== History ===== -->
                <StackPanel x:Name="PageHistory" Visibility="Collapsed">
                    <TextBlock Text="{l:Loc NavHistory}" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <c:SettingRow Icon="&#xE81C;" Header="{l:Loc HistoryRecord}" Description="{l:Loc HistoryRecordDesc}">
                                <CheckBox x:Name="HistoryToggle" Style="{StaticResource ToggleSwitch}" Click="OnSimpleToggle"/>
                            </c:SettingRow>
                            <c:SettingRow x:Name="RetentionRow" Style="{StaticResource SubRow}" Header="{l:Loc HistoryKeep}">
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Keep7" GroupName="Keep" Style="{StaticResource SegmentItem}" Checked="OnSegmentChecked"/>
                                        <RadioButton x:Name="Keep30" GroupName="Keep" Style="{StaticResource SegmentItem}" Checked="OnSegmentChecked"/>
                                        <RadioButton x:Name="Keep90" GroupName="Keep" Style="{StaticResource SegmentItem}" Checked="OnSegmentChecked"/>
                                    </StackPanel>
                                </Border>
                            </c:SettingRow>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,0" Padding="16,14,16,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="HistoryDeviceCombo" Style="{StaticResource FluentComboBox}" MinWidth="220"
                                          HorizontalAlignment="Left" SelectionChanged="OnHistoryFilterChanged"/>
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Range24h" GroupName="Range" Style="{StaticResource SegmentItem}" Content="{l:Loc Range24h}" IsChecked="True" Checked="OnHistoryFilterChanged"/>
                                        <RadioButton x:Name="Range7d" GroupName="Range" Style="{StaticResource SegmentItem}" Content="{l:Loc Range7d}" Checked="OnHistoryFilterChanged"/>
                                        <RadioButton x:Name="Range30d" GroupName="Range" Style="{StaticResource SegmentItem}" Content="{l:Loc Range30d}" Checked="OnHistoryFilterChanged"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Height="220">
                                <Canvas x:Name="HistoryCanvas" ClipToBounds="True" Background="Transparent" SizeChanged="OnHistoryCanvasSizeChanged"/>
                                <TextBlock x:Name="HistoryEmptyText" Text="{l:Loc HistoryEmpty}" Foreground="{DynamicResource SubTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button Style="{StaticResource StandardButton}" Content="{l:Loc OpenFolder}" Click="OnOpenHistoryFolderClick"/>
                                <Button Style="{StaticResource StandardButton}" Content="{l:Loc HistoryClear}" Margin="8,0,0,0" Click="OnClearHistoryClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== About ===== -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Text="{l:Loc NavAbout}" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource SettingsCard}" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{StaticResource AppLogo}" Width="56" Height="56" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc AppName}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="AboutVersion" Margin="0,2,0,0" Foreground="{DynamicResource SubTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{l:Loc Author}" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text=" · " Foreground="{DynamicResource SubTextBrush}"/>
                                    <TextBlock Text="{l:Loc License}" Foreground="{DynamicResource SubTextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,0">
                        <StackPanel>
                            <c:SettingRow Icon="&#xE895;" Header="{l:Loc AutoUpdate}" Description="{l:Loc AutoUpdateDesc}">
                                <CheckBox x:Name="AutoUpdateToggle" Style="{StaticResource ToggleSwitch}" Click="OnSimpleToggle"/>
                            </c:SettingRow>
                            <Border Style="{StaticResource RowDivider}"/>
                            <c:SettingRow x:Name="UpdateRow" Icon="&#xE896;" Header="{l:Loc UpToDate}">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="CheckUpdateButton" Style="{StaticResource StandardButton}" Content="{l:Loc CheckNow}" Click="OnCheckUpdateClick"/>
                                    <Button x:Name="InstallUpdateButton" Style="{StaticResource AccentButton}" Content="{l:Loc UpdateInstall}" Margin="8,0,0,0"
                                            Visibility="Collapsed" Click="OnInstallUpdateClick"/>
                                </StackPanel>
                            </c:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
