<!-- Content of one taskbar entry. Shared by the taskbar overlay and the Settings previews so they always match. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="TaskbarItemContent">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Device-type icon (always shown so devices can be told apart) -->
            <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                <Canvas Width="16" Height="16">
                    <Path Data="{Binding IconGeometry}"
                          Stroke="{Binding ForegroundBrush}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                </Canvas>
            </Viewbox>

            <!-- Windows-style battery glyph: 20x11 body (1px outline, 1px gap, 16x7 fill) + 2x5 terminal.
                 Integer DIP sizes keep the fill centred inside the outline. -->
            <Grid Margin="5,0,0,0"
                  VerticalAlignment="Center"
                  Visibility="{Binding BatteryIconVisibility}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="20" Height="11"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="1"
                            BorderBrush="{Binding ChargingBrush}">
                        <Border HorizontalAlignment="Left"
                                Width="{Binding BatteryFillWidth}"
                                CornerRadius="1.5"
                                Background="{Binding BatteryFillBrush}"/>
                    </Border>
                    <Border Width="2" Height="5"
                            VerticalAlignment="Center"
                            CornerRadius="0,1,1,0"
                            Background="{Binding ChargingBrush}"/>
                </StackPanel>
                <!-- Bolt centred on the 20px body; thin outline keeps the white readable on green and on the empty part -->
                <Viewbox Width="13" Height="13"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Margin="3.5,0,0,0"
                         Visibility="{Binding ChargingVisibility}">
                    <Canvas Width="16" Height="16">
                        <Path Data="{Binding ChargingBoltGeometry}"
                              Fill="{Binding BoltBrush}"
                              Stroke="{Binding BoltStrokeBrush}"
                              StrokeThickness="1.3"
                              StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- Labeled battery: 28x14 body (1px outline, 1px gap, 24x10 fill) + 2x6 terminal, number centred inside.
                 The number is drawn twice: taskbar color over the empty part, and a contrasting color
                 clipped to the fill width, so it stays readable wherever the fill edge falls. -->
            <StackPanel Orientation="Horizontal"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding LabeledBatteryVisibility}">
                <Border Width="28" Height="14"
                        BorderThickness="1"
                        CornerRadius="3.5"
                        Padding="1"
                        BorderBrush="{Binding ChargingBrush}">
                    <Grid Width="24" Height="10">
                        <Border HorizontalAlignment="Left"
                                Width="{Binding LabeledFillWidth}"
                                CornerRadius="2"
                                Background="{Binding BatteryFillBrush}"/>
                        <TextBlock Text="{Binding LevelText}"
                                   Foreground="{Binding ChargingBrush}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="9.5" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,-3,0,-2"/>
                        <Canvas HorizontalAlignment="Left"
                                Width="{Binding LabeledFillWidth}"
                                ClipToBounds="True">
                            <Grid Width="24" Height="10">
                                <TextBlock Text="{Binding LevelText}"
                                           Foreground="{Binding FillTextBrush}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="9.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,-3,0,-2"/>
                            </Grid>
                        </Canvas>
                    </Grid>
                </Border>
                <Border Width="2" Height="6"
                        VerticalAlignment="Center"
                        CornerRadius="0,1,1,0"
                        Background="{Binding ChargingBrush}"/>
            </StackPanel>

            <TextBlock Text="{Binding PercentText}"
                       Visibility="{Binding PercentageVisibility}"
                       Foreground="{Binding ForegroundBrush}"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="12"
                       Margin="5,0.5,0,0"
                       VerticalAlignment="Center"/>

            <!-- Charging bolt after the % when there is no battery glyph -->
            <Viewbox Width="11" Height="11"
                     Visibility="{Binding InlineChargingVisibility}"
                     Margin="2,0.5,0,0"
                     VerticalAlignment="Center">
                <Canvas Width="16" Height="16">
                    <Path Data="{Binding ChargingBoltGeometry}" Fill="{Binding ChargingBrush}"/>
                </Canvas>
            </Viewbox>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
