<Window x:Class="BatteryHub.App.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BatteryHub.App.Localization"
        Title="Battery Hub"
        Width="376"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12.5"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Deactivated="OnWindowDeactivated">

    <Border x:Name="RootCard"
            CornerRadius="8"
            BorderThickness="1"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            Padding="16,12,16,16"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.32" Color="Black" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,-6,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource AppLogo}"
                           Width="22" Height="22"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{l:Loc AppName}"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionText"
                               Text="v0.0.0"
                               Foreground="{DynamicResource SubTextBrush}"
                               FontSize="11"
                               Margin="8,2,0,0"
                               VerticalAlignment="Center"/>
                    <!-- Game mode chip -->
                    <Border x:Name="GameModeChip"
                            Visibility="Collapsed"
                            CornerRadius="9"
                            Padding="6,2"
                            Margin="8,1,0,0"
                            VerticalAlignment="Center"
                            ToolTip="{l:Loc GameModeActive}"
                            Background="{DynamicResource ControlHoverBrush}">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE72C;"
                            ToolTip="{l:Loc Refresh}"
                            Click="OnRefreshClick"/>
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE713;"
                            ToolTip="{l:Loc Settings}"
                            Margin="2,0,0,0"
                            Click="OnSettingsClick"/>
                </StackPanel>
            </Grid>

            <!-- Empty state -->
            <Border x:Name="EmptyStatePanel"
                    Style="{StaticResource SettingsCard}"
                    Visibility="Collapsed"
                    Padding="20,22"
                    Margin="0,4,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE702;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="26"
                               Foreground="{DynamicResource SubTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="{l:Loc NoDevicesTitle}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{l:Loc NoDevicesDesc}"
                               Foreground="{DynamicResource SubTextBrush}"
                               FontSize="11.5"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Devices -->
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" Style="{StaticResource SlimScrollViewer}">
                <ItemsControl x:Name="DevicesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CardRoot"
                                    Style="{StaticResource SettingsCard}"
                                    Padding="12,10,10,12"
                                    Margin="0,0,0,6"
                                    Opacity="{Binding OpacityValue}"
                                    ToolTip="{Binding TooltipText}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.RowSpan="2"
                                            Width="38" Height="38"
                                            CornerRadius="8"
                                            Background="{DynamicResource TileBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                        <Viewbox Width="20" Height="20">
                                            <Canvas Width="16" Height="16">
                                                <Path Data="{Binding IconGeometry}"
                                                      Stroke="{DynamicResource TextBrush}"
                                                      StrokeThickness="1.3"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EffectiveName}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   FontSize="11"
                                                   Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel x:Name="Actions"
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="6,0,4,0"
                                                Opacity="0">
                                        <Button Style="{StaticResource CardIconButton}"
                                                Content="&#xE8AB;"
                                                ToolTip="{l:Loc ChangeIcon}"
                                                Tag="{Binding Id}"
                                                Click="OnCycleCategoryClick"/>
                                        <Button Style="{StaticResource CardIconButton}"
                                                Content="{Binding VisibilityGlyph}"
                                                ToolTip="{Binding VisibilityActionText}"
                                                Tag="{Binding Id}"
                                                Click="OnToggleVisibilityClick"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="11" Height="13"
                                                 Visibility="{Binding ChargingVisibility}"
                                                 Margin="0,0,3,0"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="16" Height="16">
                                                <Path Data="{Binding ChargingBoltGeometry}" Fill="{Binding ChargingBrush}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{Binding PercentText}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ProgressBar Grid.Row="1"
                                                 Grid.Column="1"
                                                 Grid.ColumnSpan="3"
                                                 Style="{StaticResource BatteryBar}"
                                                 Value="{Binding BatteryPercent, Mode=OneWay}"
                                                 Foreground="{Binding AccentBrush}"
                                                 Margin="0,8,0,0"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
