<Window x:Class="BatteryHub.App.Views.GameOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Hub overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <!-- Always dark: it sits on top of games, whose content is unknown -->
    <Border x:Name="Card"
            Margin="16"
            CornerRadius="10"
            Background="#D9161616"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            Padding="8,6">
        <ItemsControl x:Name="Items">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentPresenter Content="{Binding}"
                                      ContentTemplate="{StaticResource TaskbarItemContent}"
                                      Margin="2,3"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
