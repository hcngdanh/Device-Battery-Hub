<Window x:Class="BatteryHub.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Hub notification"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <!-- Full toast (bottom-right, above the taskbar) -->
        <Border x:Name="FullCard"
                Width="364"
                Margin="12"
                CornerRadius="8"
                BorderThickness="1"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                Padding="14,12,8,14"
                MouseLeftButtonUp="OnCardClicked"
                Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.3" Color="Black" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource TileBrush}"
                        VerticalAlignment="Top" Margin="0,2,12,0">
                    <Grid>
                        <Viewbox x:Name="FullIconPath" Width="20" Height="20">
                            <Canvas Width="16" Height="16">
                                <Path x:Name="FullPath" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="FullIconGlyph" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <Image Source="{StaticResource AppLogo}" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Battery Hub" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="FullTitle" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="FullBody" FontSize="12.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CardIconButton}" Content="&#xE711;"
                        VerticalAlignment="Top" Click="OnCloseClicked"/>
            </Grid>
        </Border>

        <!-- Compact pill (game mode) -->
        <Border x:Name="CompactCard"
                Visibility="Collapsed"
                Margin="10"
                CornerRadius="16"
                Background="#E6202020"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Padding="12,6,14,6">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Canvas Width="16" Height="16">
                        <Path x:Name="CompactPath" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="CompactGlyph" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White"
                           VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                <TextBlock x:Name="CompactText" Foreground="White" FontSize="12.5" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
