<!-- Vector port of assets/logo.svg (512x512). Shared by the flyout header and the .ico generator. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DrawingImage x:Key="AppLogo">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M0,0 H512 V512 H0 Z">
                <!-- Background tile -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#1E3A8A"/>
                            <GradientStop Offset="1" Color="#0F172A"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="16,16,480,480" RadiusX="112" RadiusY="112"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Battery body -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="28"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="84,164,310,184" RadiusX="40" RadiusY="40"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Terminal -->
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="404,214,34,84" RadiusX="14" RadiusY="14"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Charge level -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#22C55E"/>
                            <GradientStop Offset="1" Color="#4ADE80"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="122,202,190,108" RadiusX="18" RadiusY="18"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Bolt -->
                <GeometryDrawing Brush="#FACC15" Geometry="M262,136 L180,270 H238 L218,376 L314,228 H254 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#0F172A" Thickness="14" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
